{
  "type": "object",
  "properties": {
    "reviewed_source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "omission",
              "unsupported_assertion",
              "misclassification",
              "lost_qualification",
              "cross_source_inference",
              "premature_reconciliation",
              "section_tag",
              "field_state",
              "scope",
              "evidence_reading",
              "missing_information",
              "ambiguous_information"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning"
            ]
          },
          "message": {
            "type": "string",
            "description": "Name the affected observation and exact field path relative to data. Explain the source-supported correction and cite evidence; if genuinely unstated or ambiguous, explain what must remain unresolved. Do not import fields from other sources or choose a winning source."
          },
          "observation_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string"
                },
                "source_text": {
                  "type": "string"
                }
              },
              "required": [
                "source_id",
                "source_text"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "category",
          "severity",
          "message",
          "observation_ids",
          "source_ids",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "reviewed_source_ids",
    "findings"
  ],
  "additionalProperties": false
}
