        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "json_path",
        "paragraph",
        "table",
        "row",
        "page",
        "region",
        "line"
      ],
      "additionalProperties": false,
      "description": "Copy reader-provided coordinates; null where unavailable. Do not invent locations. Use line for Markdown/text and supplied region for images."
    },
    "precision": {
      "type": "string",
      "enum": [
        "exact",
        "approximate",
        "range",
        "upper_bound",
        "lower_bound",
        "unspecified"
      ],
      "description": "Precision stated in the source. Approximation or a bound is not an extraction failure."
    },
    "field_state": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "description": "Path relative to data, for example account.account_id or commitments[0].amount."
        },
        "state": {
          "type": "string",
          "enum": [
            "explicitly_missing",
            "not_stated",
            "ambiguous",
            "not_applicable",
            "unreadable",
            "qualified_value"
          ]
        }
      },
      "required": [
        "field",
        "state"
      ],
      "additionalProperties": false,
      "description": "Describe unknown fields without conflating missing facts, unreadable evidence and deliberately non-exact amounts. qualified_value means the exact amount is null but a qualified value is preserved."
    },
    "source": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "description": "Copy the code-supplied inventory ID."
        },
        "role": {
          "type": "string",
          "enum": [
            "report_request",
            "account_records",
            "meeting_notes",
            "statement",
            "internal_guidance",
            "report_specification",
            "general_background",
            "mixed",
            "unknown"
          ]
        },
        "document_date": {
          "anyOf": [
            {
              "type": "string",
              "description": "Explicit document date as YYYY-MM-DD; never use file modification time."
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source_id",
        "role",
        "document_date"
      ],
      "additionalProperties": false,
      "description": "One classification per inventoried source. Copy source_id from inventory; code supplies filename, format and reading status in the saved result."
    },
    "commitment": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "type": "string",
