          {
            "$ref": "#/$defs/tax_statement_observation"
          },
          {
            "$ref": "#/$defs/instruction_observation"
          },
          {
            "$ref": "#/$defs/unclassified_observation"
          }
        ]
      }
    },
    "extraction_issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/extraction_issue"
      }
    }
  },
  "required": [
    "sources",
    "observations",
    "extraction_issues"
  ],
  "additionalProperties": false,
  "description": "Model response for extraction only. Code validates and enriches this result using its inventory, tool ledger and code-generated IDs.",
  "$defs": {
    "account_reference": {
      "type": "object",
      "properties": {
        "account_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "platform": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "account_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "reference_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "account_id",
        "platform",
        "account_type",
        "reference_text"
      ],
      "additionalProperties": false,
      "description": "Preserve explicit identifiers and literal descriptions; do not force an uncertain account match."
    },
    "person_reference": {
      "type": "object",
